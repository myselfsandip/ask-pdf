{
  "name": "askpdf-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "module": "NodeNext",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n api,worker -c green,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch --clear-screen=false --ignore \"uploads/**\" src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false --ignore \"uploads/**\" src/workers/document.worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/document.worker.js",
    "clean": "rm -rf node_modules dist",
    "clean:lock": "rm -rf pnpm-lock.yaml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pdf-parse": "^2.4.5",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ]
}
